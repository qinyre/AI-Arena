# =============================================================================
# Environment Configuration
# =============================================================================
# 每个 provider 只需配你实际使用的那几家。未配置的 provider 不会被调用，
# 但如果 orchestrator 尝试用一个没配 key 的 provider，会在初始化时报错提示。
# provider 与 base_url 的映射见 config/models.yaml。
# =============================================================================

# ---- LLM Provider API Keys ----

# DeepSeek（默认 provider，国内直连、便宜、推荐开发用）
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# OpenAI 官方
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic Claude（唯一非 OpenAI 协议）
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Google Gemini（通过官方 OpenAI 兼容端点）
GEMINI_API_KEY=your-gemini-api-key-here

# 通义千问 Qwen（阿里云百炼 DashScope）
DASHSCOPE_API_KEY=your-dashscope-api-key-here

# 硅基流动 SiliconFlow（聚合平台，一个 key 调多家开源模型）
SILICONFLOW_API_KEY=your-siliconflow-api-key-here

# Ollama 本地模型无需 key，仅需服务在 localhost:11434 运行

# ---- Database ----
DATABASE_URL=sqlite+aiosqlite:///./ai_arena.db

# ---- Server Configuration ----
HOST=0.0.0.0
PORT=8000
DEBUG=True

# CORS (for development)
CORS_ORIGINS=["http://localhost:5173"]

# Security
SECRET_KEY=your-secret-key-here-change-in-production

# Logging
LOG_LEVEL=INFO
