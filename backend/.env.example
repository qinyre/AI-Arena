# =============================================================================
# Environment Configuration
# =============================================================================
# 每个 provider 只需配你实际使用的那几家。未配置的 provider 不会被调用，
# 但如果 orchestrator 尝试用一个没配 key 的 provider，会在初始化时报错提示。
# provider 与 base_url 的映射见 config/models.yaml。
# =============================================================================

# ---- LLM Provider API Keys ----

# DeepSeek（默认 provider，国内直连、便宜、推荐开发用）
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# OpenAI 官方
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic Claude（唯一非 OpenAI 协议）
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Google Gemini（通过官方 OpenAI 兼容端点）
GEMINI_API_KEY=your-gemini-api-key-here

# 通义千问 Qwen（阿里云百炼 DashScope）
DASHSCOPE_API_KEY=your-dashscope-api-key-here

# Kimi（月之暗面）
MOONSHOT_API_KEY=your-moonshot-api-key-here

# Xiaomi MiMo
MIMO_API_KEY=your-mimo-api-key-here

# MiniMax
MINIMAX_API_KEY=your-minimax-api-key-here

# 智谱 GLM
ZHIPU_API_KEY=your-zhipu-api-key-here

# 硅基流动 SiliconFlow（聚合平台，一个 key 调多家开源模型）
SILICONFLOW_API_KEY=your-siliconflow-api-key-here


# ---- Database ----
DATABASE_URL=sqlite+aiosqlite:///./ai_arena.db

# ---- Server Configuration ----
HOST=0.0.0.0
PORT=8000
DEBUG=True

# CORS (for development)
# 留空 -> 自动放行所有本地地址(localhost / 127.0.0.1,任意端口),开发期最省心。
# 生产环境填逗号分隔的精确 origin,例如:CORS_ORIGINS=https://aiarena.example.com,https://www.aiarena.example.com
# 注意:不要写成 JSON 数组(如 ["http://..."]),python-dotenv 会当成字面字符串导致匹配失败。
CORS_ORIGINS=

# Security
SECRET_KEY=your-secret-key-here-change-in-production

# Logging
LOG_LEVEL=INFO
